function plotSensitivity(app, event)

value = app.sensitivityDropDown.Value;
[file, path] = uigetfile;
Sensitivity = load(fullfile(path,file));

% Get the AtlasState structure stored earlier
hFig = app.UIFigure;
AtlasState = getappdata(hFig, 'AtlasState');

% Check if it exists
if isempty(AtlasState)
    uialert(app.UIFigure, 'Please load AtlasViewer data first.', 'Data Missing');
    return;
end

% --- Create a new figure as a child of the app ---
fig = figure('Name', 'Atlas Viewer', ...
             'NumberTitle', 'off', ...
             'Color', [1 1 1], ...
             'Visible', 'on', ...
             'Units', 'normalized', ...
             'Position', [0.2 0.2 0.5 0.5], ...
             'HandleVisibility', 'callback', ...
             'CloseRequestFcn', @(src,evt) delete(src));
% So if app closes, this figure also closes
addlistener(app, 'ObjectBeingDestroyed', @(~,~) delete(fig));

% --- First axes (e.g., left plot)
ax1 = axes('Parent', fig, 'Position', [0.1 0.1 0.35 0.8]); 
title(ax1, 'Left Hemisphere');
hold(ax1, 'on');

% --- Second axes (e.g., right plot)
ax2 = axes('Parent', fig, 'Position', [0.55 0.1 0.35 0.8]);
title(ax2, 'Right Hemisphere');
hold(ax2, 'on');

% plot_intensity(ax, cfg,faces, brain_vertices, int_at_pos, rotation)
cfg = [];
% if value == 'Head'
    plot_intensity(ax1, cfg, AtlasState.headsurf.mesh.faces,Sensitivity)
elseif value == 'Brain'
    % create a function to plot head surface and sensitivity
    plot_Sensitivity_Pial(app)
end