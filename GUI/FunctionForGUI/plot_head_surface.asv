function plot_head_surface(ax, AtlasState)

    % Check required fields
    if ~isfield(AtlasState, 'headsurf')
        error('AtlasState must contain headsurf.');
    end

    if ~isfield(AtlasState.headsurf,'mesh')
        error('AtlasState.headsurf must contain mesh')
    end

    if ~isfield(AtlasState.headsurf.mesh,'vertices')||~isfield(AtlasState.headsurf.mesh,'faces')
        error('AtlasState.headsurf must contain vertices and faces')
    end
    % Clear axes
    cla(ax);
    figure
    ax = axes;
    brain_vertices = AtlasState.headsurf.mesh.vertices;
    faces = AtlasState.headsurf.mesh.faces;
    axes_order = [2, 1, 3]; % Define the axes order for plotting
    int_at_pos = zeros(size(brain_vertices, 1), 1); % Initialize intensity values
    % h = trisurf(ax, faces, brain_vertices(:,axes_order(1)), brain_vertices(:,axes_order(2)), brain_vertices(:,axes_order(3)), ...
    %   int_at_pos,'facecolor','interp','edgealpha',0, 'visible','on');
    ax = trisurf(faces, brain_vertices(:,axes_order(1)), ...
        brain_vertices(:,axes_order(2)), ...
        brain_vertices(:,axes_order(3)), ...
        int_at_pos,...
        'Parent',ax,...
        'Facecolor',
        'visible','on');
    % Set view, lighting, and axis properties
    axis(ax, 'equal');
    axis(ax, 'off');
    view(ax, 3);
    camlight(ax, 'headlight');
    lighting(ax, 'gouraud');
end

